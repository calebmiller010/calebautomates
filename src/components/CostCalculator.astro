---
// "What the manual way costs" calculator (2026-07-03; Problem merged in 2026-09-30). The site's
// primary interactive conversion hook. Deliberately does arithmetic on the VISITOR'S OWN inputs —
// no claims about Caleb, no benchmarks, no promised savings — so it carries zero fabrication risk.
// Self-contained inline script; ships in static output (no hydration framework). Lead capture =
// a mailto pre-filled with the computed numbers (address comes from lib/links.ts via a data
// attribute, since the script runs in the browser).
import { BOOKING_URL, EMAIL, CTA_PRIMARY } from '../lib/links';

const pains = [
  'Copying data between apps by hand every day',
  'Sending the same follow-up emails manually each week',
  'Generating the same reports from the same spreadsheets',
  'Manually routing inbound leads or requests to the right person',
  'Chasing down documents, signatures, or status updates',
];
---

<section id="cost-calculator">
  <div class="container">
    <div class="section-head calc-header">
      <div class="eyebrow">What it costs</div>
      <h2 class="title title--section">What the manual way costs</h2>
      <p class="lede">Rough math, not a quote — but it’s usually the number that gets ignored until someone writes it down. Plug in one task your team repeats by hand.</p>
    </div>

    <div class="calc-familiar">
      <p class="calc-familiar-label">Sound familiar?</p>
      <ul class="calc-pains" role="list">
        {pains.map((p) => <li>{p}</li>)}
      </ul>
    </div>

    <div class="calc-card">
      <div class="calc-inputs">
        <label class="calc-field calc-field-wide">
          <span class="calc-label">The manual task</span>
          <input type="text" id="calc-task" placeholder="e.g. copying invoice data into QuickBooks" autocomplete="off" />
        </label>
        <label class="calc-field">
          <span class="calc-label">Hours/week, per person</span>
          <input type="number" id="calc-hours" min="0.5" max="40" step="0.5" value="3" />
        </label>
        <label class="calc-field">
          <span class="calc-label">People doing it</span>
          <input type="number" id="calc-people" min="1" max="50" step="1" value="1" />
        </label>
        <label class="calc-field">
          <span class="calc-label">Fully-loaded hourly cost</span>
          <input type="number" id="calc-rate" min="10" max="500" step="5" value="35" />
          <span class="calc-hint">Salary ÷ 2,000, plus ~25–30% for benefits/overhead is a common rule of thumb — or just estimate.</span>
        </label>
      </div>

      <div class="calc-output" id="calc-output" aria-live="polite">
        <p class="calc-output-lead"><span id="calc-taskname">This task</span> is costing your team an estimated</p>
        <div class="calc-metrics">
          <div class="calc-metric">
            <div class="stat calc-stat" id="calc-hours-out">144</div>
            <div class="calc-metric-label">hours per year</div>
          </div>
          <div class="calc-metric">
            <div class="stat calc-stat" id="calc-cost-out">$5,040</div>
            <div class="calc-metric-label">per year</div>
          </div>
        </div>
        <p class="calc-weeks" id="calc-weeks"></p>
        <p class="calc-disclaimer">This is a simple time-cost estimate you're providing — not an audit, and not a guarantee of savings. It's meant to make the cost visible, nothing more.</p>
      </div>

      <p class="calc-pivot">That's the kind of task that's usually worth automating first — repetitive, rule-based, done by hand mostly because nobody's gotten around to it. I can't promise this exact task is automatable without seeing it, but it's worth 20 minutes to find out for sure.</p>

      <div class="btn-row calc-actions">
        <a class="btn btn--primary" href={BOOKING_URL} target="_blank" rel="noopener">
          {CTA_PRIMARY}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
        <a class="btn btn--link" id="calc-mailto" href={'mailto:' + EMAIL} data-email={EMAIL}>or email me these numbers &rarr;</a>
      </div>
      <p class="calc-xlink">Not sure which task to start with? <a href="/quiz/">Take the 2-minute automation quiz &rarr;</a></p>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const $ = (id) => document.getElementById(id);
    const task = $('calc-task'), hours = $('calc-hours'), people = $('calc-people'), rate = $('calc-rate');
    const taskOut = $('calc-taskname'), hoursOut = $('calc-hours-out'), costOut = $('calc-cost-out'),
      weeksOut = $('calc-weeks'), mailto = $('calc-mailto');
    if (!hours) return;
    const email = mailto.getAttribute('data-email');
    const clamp = (n, lo, hi, d) => (isFinite(n) && n > 0 ? Math.min(Math.max(n, lo), hi) : d);
    function recompute() {
      const hpw = clamp(parseFloat(hours.value), 0.5, 40, 3);
      const ppl = clamp(parseInt(people.value, 10), 1, 50, 1);
      const rt = clamp(parseFloat(rate.value), 10, 500, 35);
      const annualHours = Math.round(hpw * ppl * 48); // 48 wks = conservative (subtracts ~PTO)
      const annualCost = Math.round(annualHours * rt);
      const name = (task.value || '').trim() || 'This task';
      taskOut.textContent = name;
      hoursOut.textContent = annualHours.toLocaleString();
      costOut.textContent = '$' + annualCost.toLocaleString();
      weeksOut.textContent = annualHours >= 40
        ? "That's roughly " + Math.round(annualHours / 40) + " full 40-hour work-weeks on a task a script could run unattended."
        : '';
      const subject = 'A manual task costing us ~$' + annualCost.toLocaleString() + '/yr';
      const body =
        "Hi Caleb — here's what I plugged into the calculator on your site:\n\n" +
        'Task: ' + name + '\nHours/week per person: ' + hpw + '\nPeople doing it: ' + ppl +
        '\nEstimated hourly cost: $' + rt + '\n\nEstimated annual cost: ~$' + annualCost.toLocaleString() +
        ' (' + annualHours.toLocaleString() + ' hours)\n\nWant to talk about whether this is automatable?';
      mailto.href = 'mailto:' + email + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    }
    [task, hours, people, rate].forEach((el) => el && el.addEventListener('input', recompute));
    recompute();
  })();
</script>

<style>
  .calc-header { max-width: 40rem; }
  .calc-familiar { max-width: 52rem; margin-bottom: var(--space-10); }
  .calc-familiar-label { font-size: var(--text-sm); font-weight: 600; color: var(--color-text); margin-bottom: var(--space-3); }
  .calc-pains { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .calc-pains li { font-size: var(--text-base); color: var(--color-text-muted); padding: var(--space-3) 0; border-top: 1px solid var(--color-border); }
  .calc-pains li:last-child { border-bottom: 1px solid var(--color-border); }
  .calc-card {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-xl); padding: clamp(var(--space-6), 4vw, var(--space-10));
    max-width: 52rem;
  }
  .calc-inputs { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); }
  .calc-field { display: flex; flex-direction: column; gap: var(--space-2); }
  .calc-field-wide { grid-column: 1 / -1; }
  .calc-label { font-size: var(--text-sm); font-weight: 600; color: var(--color-text); }
  .calc-field input {
    font: inherit; font-size: var(--text-base); color: var(--color-text);
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); padding: var(--space-3) var(--space-4); width: 100%; min-height: 44px;
    transition: border-color var(--transition);
  }
  .calc-field input:focus { border-color: var(--color-primary); }
  .calc-field input:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .calc-hint { font-size: var(--text-xs); color: var(--color-text-muted); line-height: 1.5; }
  .calc-output { margin-top: var(--space-8); padding-top: var(--space-8); border-top: 1px solid var(--color-border); }
  .calc-output-lead { font-size: var(--text-base); color: var(--color-text-muted); margin-bottom: var(--space-5); }
  .calc-metrics { display: flex; flex-wrap: wrap; gap: var(--space-8) var(--space-12); }
  .calc-stat { font-size: var(--text-2xl); }
  .calc-metric-label { font-size: var(--text-sm); color: var(--color-text-muted); margin-top: var(--space-2); }
  .calc-weeks { font-size: var(--text-base); color: var(--color-text); margin-top: var(--space-6); font-weight: 500; }
  .calc-disclaimer { font-size: var(--text-xs); color: var(--color-text-muted); margin-top: var(--space-5); }
  .calc-pivot { font-size: var(--text-base); color: var(--color-text-muted); margin-top: var(--space-8); max-width: 54ch; }
  .calc-actions { margin-top: var(--space-8); gap: var(--space-6); }
  .calc-xlink { margin-top: var(--space-6); font-size: var(--text-sm); color: var(--color-text-muted); }
  .calc-xlink a { color: var(--color-primary); }
  @media (max-width: 680px) { .calc-inputs { grid-template-columns: 1fr; } }
</style>
