---
import WatchItWork from './WatchItWork.astro';

const services = [
  {
    title: 'Document & Content Pipelines',
    desc: 'Raw input goes in — formatted, accurate output comes out automatically. No manual transcription, formatting, or distribution.',
    eg: 'E.g. meeting notes → structured summaries → auto-emailed to your team. Or: audio/video → transcription → formatted report.',
  },
  {
    title: 'Client Communication Automation',
    desc: 'Follow-ups, onboarding sequences, status updates, and reminders — triggered automatically based on what\'s happening in your business.',
    eg: 'E.g. new lead fills form → CRM updated → personalized follow-up sent → you\'re notified only if they reply.',
  },
  {
    title: 'Internal Ops & Reporting',
    desc: 'Data that lives in multiple places gets pulled together, processed, and delivered as a clean report — on schedule, every time.',
    eg: 'E.g. weekly ops dashboard built automatically from your existing tools, delivered to your inbox every Monday morning.',
  },
];
---

<section id="services">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Services</div>
      <h2 class="title title--section">What I build</h2>
      <p class="lede">Three kinds of systems, one outcome: less manual work.</p>
    </div>

    <ul class="svc-list" role="list">
      {services.map((s) => (
        <li class="svc-row">
          <h3 class="title title--small svc-title">{s.title}</h3>
          <div class="svc-body">
            <p class="svc-desc">{s.desc}</p>
            <p class="svc-eg">{s.eg}</p>
          </div>
        </li>
      ))}
    </ul>

    <details class="svc-demo">
      <summary class="svc-demo-summary">See an example run</summary>
      <div class="svc-demo-body">
        <WatchItWork />
      </div>
    </details>
  </div>
</section>

<style>
  .svc-list { list-style: none; margin: 0; padding: 0; max-width: 52rem; }
  .svc-row {
    display: grid; grid-template-columns: 16rem 1fr; gap: var(--space-2) var(--space-8);
    padding: var(--space-6) 0; border-top: 1px solid var(--color-border);
  }
  .svc-row:last-child { border-bottom: 1px solid var(--color-border); }
  .svc-title { margin: 0; }
  .svc-desc { font-size: var(--text-base); color: var(--color-text); max-width: 54ch; }
  .svc-eg { font-size: var(--text-sm); line-height: 1.5; color: var(--color-text-muted); margin-top: var(--space-2); max-width: 54ch; }

  .svc-demo { max-width: 52rem; margin-top: var(--space-8); }
  .svc-demo-summary {
    display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; cursor: pointer;
    list-style: none; font-size: var(--text-sm); font-weight: 600; color: var(--color-primary);
  }
  .svc-demo-summary::-webkit-details-marker { display: none; }
  .svc-demo-summary::after { content: '+'; font-weight: 600; }
  .svc-demo[open] .svc-demo-summary::after { content: '−'; }
  .svc-demo-summary:hover { text-decoration: underline; text-underline-offset: 3px; }
  .svc-demo-body { margin-top: var(--space-4); padding: clamp(var(--space-5), 3vw, var(--space-8)); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); }
  @media (max-width: 680px) { .svc-row { grid-template-columns: 1fr; } }
</style>
