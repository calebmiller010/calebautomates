---
// Focused, low-friction CTA: the whole ask is "book a call". Fallback for people not ready to
// book = a one-click prefilled email (no form backend). Renders on the fixed dark band
// (#contact in global.css); colours come from the --band-* tokens so it stays theme-fixed.
import { BOOKING_URL, CONTACT_MAILTO, CTA_PRIMARY, CTA_EMAIL } from '../lib/links';
---

<section id="contact" class="section--tight">
  <div class="container">
    <h2 class="title title--section cta-title">Start with a 20-minute call.</h2>
    <p class="cta-sub">
      The first call is free. I'll find at least 5 hours a week your team could get back — or tell you straight there's nothing here.
    </p>

    <div class="btn-row cta-actions">
      <a class="btn cta-primary" href={BOOKING_URL} target="_blank" rel="noopener">
        {CTA_PRIMARY}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
      </a>
      <a class="btn btn--link cta-email" href={CONTACT_MAILTO}>{CTA_EMAIL}</a>
    </div>
  </div>
</section>

<style>
  #contact { color: var(--band-text); }
  .cta-title { color: var(--band-heading); max-width: none; margin-inline: auto; }
  .cta-sub { color: var(--band-muted); font-size: var(--text-base); max-width: 48ch; margin: var(--space-4) auto 0; }
  .cta-actions { margin-top: var(--space-8); justify-content: center; gap: var(--space-6); }
  .cta-primary { background: var(--band-accent); color: var(--band-bg); }
  .cta-primary:hover { background: var(--band-accent-hover); color: var(--band-bg); }
  .cta-email { color: var(--band-accent-hover); }
  .cta-email:hover { color: var(--band-heading); }
</style>
