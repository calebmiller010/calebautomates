---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { BOOKING_URL, CONTACT_MAILTO, CTA_PRIMARY, CTA_EMAIL } from '../../lib/links';

export async function getStaticPaths() {
  const items = await getCollection('blog', (e) => e.data.published);
  return items.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Base title={`${entry.data.title} — Caleb Automates`} description={entry.data.description}>
  <article id="post-detail">
    <div class="container">
      <a class="back-link" href="/blog/">← All articles</a>
      <h1 class="title title--section post-title">{entry.data.title}</h1>
      <div class="post-byline">By Caleb · calebautomates.com</div>

      <div class="prose post-prose">
        <Content />
      </div>

      {
        entry.data.tags.length > 0 && (
          <div class="tech-tags post-tags">
            {entry.data.tags.map((t) => (
              <span class="tech-tag">{t}</span>
            ))}
          </div>
        )
      }

      <div class="post-cta">
        <div>
          <div class="title title--small">Want a second pair of eyes on your busywork?</div>
          <div class="post-cta-sub">A free 20-minute call — I'll find at least 5 hours a week your team could get back, or tell you straight there's nothing here. No pitch.</div>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href={BOOKING_URL} target="_blank" rel="noopener">
            {CTA_PRIMARY}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </a>
          <a class="btn btn--link" href={CONTACT_MAILTO}>{CTA_EMAIL}</a>
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  #post-detail .container { max-width: 720px; }
  .back-link { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--text-sm); color: var(--color-text-muted); text-decoration: none; margin-bottom: var(--space-6); }
  .back-link:hover { color: var(--color-text); }
  .post-title { max-width: 24ch; margin-bottom: var(--space-3); }
  .post-byline { font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--space-10); }
  .post-tags { margin-top: var(--space-8); }
  .post-cta { margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--color-border); display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); flex-wrap: wrap; }
  .post-cta-sub { font-size: var(--text-sm); color: var(--color-text-muted); max-width: 52ch; margin-top: var(--space-1); }
</style>
