---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('portfolio', (e) => e.data.published)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title="Portfolio — Caleb Automates"
  description="Systems Caleb has built — for local organizations, small businesses, and across a nine-year engineering career. In production and running."
>
  <section id="portfolio-hero">
    <div class="container">
      <div class="problem-label">Portfolio</div>
      <h1 class="section-title">Systems that are <em>still running.</em></h1>
      <p class="portfolio-intro">
        Not mockups or demos — real systems in production, built to run without babysitting. Some
        are independent work for local organizations; some come from my engineering career. Each
        one says which.
      </p>
    </div>
  </section>

  <section id="portfolio-list">
    <div class="container">
      <div class="portfolio-grid">
        {
          entries.map((e) => (
            <a class="portfolio-card" href={`/portfolio/${e.slug}/`}>
              <div class="case-badge">Case Study</div>
              <h2 class="portfolio-card-title">{e.data.title}</h2>
              <div class="portfolio-client">{e.data.client}</div>
              <p class="portfolio-summary">{e.data.summary}</p>
              {e.data.metrics.length > 0 && (
                <div class="portfolio-metrics">
                  {e.data.metrics.map((m) => (
                    <div class="portfolio-metric">
                      <span class="portfolio-metric-num">{m.value}</span>
                      <span class="portfolio-metric-label">{m.label}</span>
                    </div>
                  ))}
                </div>
              )}
              <span class="portfolio-readmore">Read the case study →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  #portfolio-hero {
    padding-block: clamp(var(--space-16), 9vw, var(--space-24)) clamp(var(--space-8), 4vw, var(--space-12));
    border-bottom: 1px solid var(--color-border);
  }
  .portfolio-intro {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 54ch;
    margin-top: var(--space-4);
    line-height: 1.6;
  }
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(360px, 100%), 1fr));
    gap: var(--space-6);
  }
  .portfolio-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    transition: box-shadow var(--transition), transform var(--transition), border-color var(--transition);
  }
  .portfolio-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    border-color: var(--color-primary-highlight);
  }
  .portfolio-card-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    color: var(--color-text);
    line-height: 1.2;
  }
  .portfolio-client {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .portfolio-summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.65;
  }
  .portfolio-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .portfolio-metric {
    display: flex;
    flex-direction: column;
  }
  .portfolio-metric-num {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-text);
  }
  .portfolio-metric-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .portfolio-readmore {
    margin-top: auto;
    padding-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
