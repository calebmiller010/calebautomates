---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { BOOKING_URL, CONTACT_MAILTO, CTA_PRIMARY, CTA_EMAIL } from '../../lib/links';

export async function getStaticPaths() {
  const items = await getCollection('portfolio', (e) => e.data.published);
  return items.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Base title={`${entry.data.title} — Caleb Automates`} description={entry.data.summary}>
  <article id="case-detail">
    <div class="container">
      <a class="back-link" href="/portfolio/">← All case studies</a>
      <h1 class="title title--section case-detail-title">{entry.data.title}</h1>
      <div class="eyebrow case-detail-client">{entry.data.client}</div>

      {
        entry.data.metrics.length > 0 && (
          <div class="case-detail-metrics">
            {entry.data.metrics.map((m) => (
              <div class="cdm-box">
                <span class="stat">{m.value}</span>
                <span class="cdm-label">{m.label}</span>
              </div>
            ))}
          </div>
        )
      }

      <div class="prose">
        <Content />
      </div>

      {
        entry.data.tags.length > 0 && (
          <div class="tech-tags case-detail-tags">
            {entry.data.tags.map((t) => (
              <span class="tech-tag">{t}</span>
            ))}
          </div>
        )
      }

      <div class="case-detail-cta">
        <div>
          <div class="title title--small">Have a routine like this eating your team's time?</div>
          <div class="case-cta-sub">Book a 20-minute call — I'll find at least 5 hours a week back or tell you straight there's nothing here.</div>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href={BOOKING_URL} target="_blank" rel="noopener">
            {CTA_PRIMARY}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </a>
          <a class="btn btn--link" href={CONTACT_MAILTO}>{CTA_EMAIL}</a>
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  #case-detail .container {
    max-width: 760px;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: var(--space-6);
  }
  .back-link:hover {
    color: var(--color-text);
  }
  .case-detail-title {
    margin-bottom: var(--space-3);
    max-width: 24ch;
  }
  /* Carries honesty labels ("Volunteer project", "Engineering career"): muted, full-size, sentence case. */
  .case-detail-client {
    font-size: var(--text-sm);
    text-transform: none;
    letter-spacing: 0.01em;
    margin-bottom: var(--space-8);
  }
  .case-detail-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: var(--space-10);
  }
  .cdm-box {
    flex: 1 1 140px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-5);
    background: var(--color-surface);
  }
  .cdm-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .case-detail-tags {
    margin-top: var(--space-8);
  }
  .case-detail-cta {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .case-cta-sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 52ch;
    margin-top: var(--space-1);
  }
</style>
