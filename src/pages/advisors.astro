---
// "For advisors & referral partners" (2026-09-30). Audience = exit planners (CEPAs), business
// brokers, CPAs, fractional CFOs, bankers, attorneys — people with owner relationships who have no
// software/systems specialist on their bench. Positioning: a complementary specialist who stays in
// his lane, not an exit consultant. Honesty: no claims about valuation impact or referral volume;
// the "why it matters" section describes what buyers look at, not results Caleb has produced.
import Base from '../layouts/Base.astro';
import { BOOKING_URL, mailto } from '../lib/links';

const MAILTO = mailto(
  'Referral / intro',
  "Hi Caleb — I work with an owner who could use a look at their systems.\n\n(A line or two on the business and what's manual or fragile)\n\n"
);

// "Who you'd be introducing": facts drawn from copy already on this page / the site. No photo slot.
const facts = [
  'Nine years building production software in healthcare, fintech, and government work',
  'One person — you and your client talk to the builder',
  'Kansas City; happy to meet in person',
];

const helps = [
  {
    t: 'Find where the owner is the process',
    d: 'I map the recurring work — quoting, scheduling, invoicing, reporting, follow-ups — and flag every step that only happens because one person remembers to do it.',
  },
  {
    t: 'Automate the repetitive back office',
    d: 'Data re-keyed between apps, the same emails sent by hand, reports rebuilt every Monday. I build the automations and hand them off with plain-language docs.',
  },
  {
    t: 'Connect the tools they already have',
    d: 'Most small businesses run on a CRM, accounting software, and a pile of spreadsheets that don’t talk. I wire them together so the numbers agree.',
  },
  {
    t: 'Make the numbers visible',
    d: 'A simple, automatic weekly view of the business — pulled from the systems they already use — instead of a report someone assembles by hand.',
  },
];

const steps = [
  { t: 'You make the intro', d: 'A short email to both of us is plenty. No forms, no referral paperwork.' },
  { t: 'I talk with the owner', d: 'A free 20-minute call about what’s manual, fragile, or stuck in someone’s head. No pitch.' },
  { t: 'Everyone knows what I found', d: 'With the owner’s OK, I loop you in on what I found and what I recommended, so it fits the plan you’re already working on.' },
  { t: 'Fixed scope, fixed price', d: 'If there’s something worth building, the owner gets a written scope and price before any work starts — or an honest “not worth it yet.”' },
];
---

<Base
  title="For Advisors & Referral Partners — Caleb Automates"
  description="For exit planners, brokers, CPAs, and advisors: a systems and automation specialist for your clients — so the business runs on systems, not on the owner's memory."
>
  <section id="adv-hero">
    <div class="container">
      <div class="eyebrow">For advisors &amp; referral partners</div>
      <h1 class="title title--section adv-h1">A systems specialist for the owners you advise.</h1>
      <p class="lede adv-lede">
        You already have the attorney, the CPA, and the wealth advisor. When a client's business runs
        on spreadsheets, sticky notes, and the owner's memory, I'm the person who fixes that part.
        I help small businesses automate the repetitive work and put real systems under it.
      </p>
      <div class="btn-row adv-actions">
        <a class="btn btn--primary" href={BOOKING_URL} target="_blank" rel="noopener">
          Book a time
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
        <a class="btn btn--link" href={MAILTO}>or make an intro by email &rarr;</a>
      </div>
    </div>
  </section>

  <section class="section--tight adv-who">
    <div class="container">
      <h2 class="eyebrow">Who you'd be introducing</h2>
      <ul class="adv-facts" role="list">
        {facts.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </section>

  <section>
    <div class="container adv-two">
      <div>
        <div class="eyebrow">Why it matters to your clients</div>
        <h2 class="title title--card adv-h2">A business that runs on systems is easier to grow — and easier to hand off.</h2>
      </div>
      <div class="adv-prose">
        <p>
          Whether an owner wants to grow, step back, or eventually sell, the same question comes up:
          how much of this business only works because one person is holding it together? Buyers,
          lenders, and successors all look hard at that.
        </p>
        <p>
          Documented, automated processes are part of the answer. They free the owner's time now, and
          they make the business less dependent on any one person later. That's the part I work on
          — the day-to-day operations, not the deal.
        </p>
      </div>
    </div>
  </section>

  <section class="adv-rule">
    <div class="container">
      <h2 class="title title--card adv-head">What I do for your clients</h2>
      <dl class="adv-defs">
        {helps.map((h) => (
          <div class="adv-def">
            <dt>{h.t}</dt>
            <dd>{h.d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="adv-rule">
    <div class="container">
      <h2 class="title title--card adv-head">How a referral works</h2>
      <ol class="adv-steps" role="list">
        {steps.map((s, i) => (
          <li class="adv-step">
            <span class="adv-num stat" aria-hidden="true">{i + 1}</span>
            <div>
              <h3 class="adv-step-t">{s.t}</h3>
              <p class="adv-step-d">{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="adv-cta">
        <div>
          <h2 class="title title--card">Let's get coffee.</h2>
          <p class="adv-cta-d">I'm in Kansas City and glad to meet in person, or we can start with a quick call. I'd like to learn how you work with owners and where I might fit.</p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href={BOOKING_URL} target="_blank" rel="noopener">Book a time</a>
          <a class="btn btn--link" href={MAILTO}>or email me &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container adv-two">
      <div>
        <div class="eyebrow">What I don't do</div>
        <h2 class="title title--card adv-h2">I stay in my lane.</h2>
      </div>
      <div class="adv-prose">
        <p>
          I don't give financial, tax, legal, or valuation advice, and I'm not going to compete with
          you for the relationship. I'm the technical specialist: I look at how the work actually gets
          done, fix what's manual or fragile, and report back in plain language.
        </p>
        <p>
          My background: nine years building production software in healthcare, fintech, and
          government work, and today, automations and software for local organizations.
          <a href="/portfolio/">See the work</a> or <a href="/#about">read more about me</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  #adv-hero { padding-bottom: var(--section-y-tight); border-bottom: 1px solid var(--color-border); }
  .adv-h1 { max-width: 24ch; margin-bottom: var(--space-4); }
  .adv-lede { max-width: 58ch; }
  .adv-actions { margin-top: var(--space-8); }

  /* "Who you'd be introducing": three plain facts, ruled, no cards */
  .adv-who { border-bottom: 1px solid var(--color-border); }
  .adv-who .eyebrow { margin-bottom: var(--space-5); }
  .adv-facts {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }
  .adv-facts li {
    max-width: none;
    padding-top: var(--space-4);
    border-top: 2px solid var(--color-text);
    font-size: var(--text-base);
    line-height: 1.45;
    color: var(--color-text);
  }

  .adv-two {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--space-10);
    align-items: start;
  }
  .adv-h2 { max-width: 22ch; }
  .adv-prose p { color: var(--color-text-muted); max-width: 60ch; }
  .adv-prose p + p { margin-top: var(--space-4); }
  .adv-prose a { color: var(--color-primary); }

  .adv-rule { border-top: 1px solid var(--color-border); }
  .adv-head { margin-bottom: var(--space-8); }

  /* What I do: definition list */
  .adv-defs { max-width: 46rem; display: flex; flex-direction: column; gap: var(--space-6); }
  .adv-def dt { font-size: var(--text-base); font-weight: 600; color: var(--color-text); }
  .adv-def dd { font-size: var(--text-base); color: var(--color-text-muted); margin-top: var(--space-1); max-width: 62ch; }

  /* How a referral works: one vertical numbered list */
  .adv-steps { list-style: none; max-width: 46rem; display: flex; flex-direction: column; gap: var(--space-6); }
  .adv-step { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: var(--space-4); align-items: start; max-width: none; }
  .adv-num { color: var(--color-primary); line-height: 1.25; }
  .adv-step-t { font-size: var(--text-base); font-weight: 600; color: var(--color-text); line-height: 1.3; }
  .adv-step-d { font-size: var(--text-base); color: var(--color-text-muted); margin-top: var(--space-1); }

  .adv-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(var(--space-6), 4vw, var(--space-10));
  }
  .adv-cta > div:first-child { max-width: 52ch; }
  .adv-cta-d { color: var(--color-text-muted); margin-top: var(--space-2); }

  @media (max-width: 760px) {
    .adv-two { grid-template-columns: 1fr; gap: var(--space-4); }
    .adv-facts { grid-template-columns: 1fr; gap: var(--space-5); }
  }
</style>
